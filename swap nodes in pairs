class Solution:
    def swapPairs(self, head: Optional[ListNode]) -> Optional[ListNode]:
        if not head or head.next is None:
            return head
        
        swap1 = swap2 = None
        new_head = None
        prev = None

        node = head
        while node:
            if swap1 is None:
                swap1 = node
            elif swap2 is None:
                swap2 = node
                if new_head is None:
                    new_head = swap2
            
            node = node.next

            if swap1 and swap2:
                swap1.next = node
                swap2.next = swap1
                if prev is not None:
                    prev.next = swap2
                prev = swap1
                swap1 = swap2 = None
                
        return new_head
